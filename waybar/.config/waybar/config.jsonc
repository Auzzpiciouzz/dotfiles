// horizontal_block
{
  "layer": "top",
  "exclusive": true,
  "reload_style_on_change": true,
  "position": "top",
  "spacing": 4,
  "height": 28,
  "margin-top": 2,
  "margin-left": 10,
  "margin-right": 10,
  "margin-bottom": 0,

  // --- MODULE LAYOUT ---
  "modules-left": [
    "custom/launcher",
    "hyprland/workspaces",
    "custom/weather",
    "custom/notification"
  ],

  "modules-center": [
    "group/updates-drawer",
    "clock"
    // "group/mpris-drawer"
  ],

  "modules-right": [
    "tray",
    "group/network-drawer",
    "pulseaudio#output",
    "group/backlight-drawer",
    "cpu",
    "memory",
    "battery",
    "group/power-drawer"
  ],

  // --- DRAWERS & GROUPS ---

  "group/network-drawer": {
    "orientation": "horizontal",
    "drawer": {
      "transition-duration": 400,
      "children-class": "network-drawer",
      "click-to-reveal": false,
      "transition-left-to-right": false
    },
    "modules": [
      "custom/net-speed",
      "network",
      "bluetooth"
    ]
  },

  "group/backlight-drawer": {
    "orientation": "horizontal",
    "drawer": {
      "transition-duration": 400,
      "children-class": "backlight-drawer",
      "click-to-reveal": false,
      "transition-left-to-right": false
    },
    "modules": [
      "backlight",
      "custom/theme-toggle"
    ]
  },

  "group/updates-drawer": {
    "orientation": "horizontal",
    "drawer": {
      "transition-duration": 400,
      "children-class": "updates-drawer",
      "click-to-reveal": false,
      "transition-left-to-right": false
    },
    "modules": [
      "custom/updates-trigger",
      "custom/updates"
    ]
  },

/*  "group/mpris-drawer": {
    "orientation": "horizontal",
    "drawer": {
      "transition-duration": 600,
      "children-class": "mpris-drawer",
      "click-to-reveal": false,
      "transition-left-to-right": true
    },
    "modules": [
      "custom/mpris-trigger",
      "mpris"
    ]
  },*/

  "group/power-drawer": {
    "orientation": "horizontal",
    "drawer": {
      "transition-duration": 400,
      "children-class": "power-drawer",
      "click-to-reveal": false,
      "transition-left-to-right": false
    },
    "modules": [
      "custom/power",
      "custom/inhibit-suspend"
    ]
  },

  // --- MODULE CONFIGURATION ---

  "custom/launcher": {
    "format": "󰌽",
    "on-click": "~/.config/waybar/scripts/control-menu.sh",
    "on-click-right": "swaync-client -t -sw",
    "tooltip-format": "Control Center"
  },

  "clock": {
    "format": "{:%I:%M %p}",
    "format-alt": "󰃭 {:%A, %B %d}",
    "tooltip-format": "<tt>{calendar}</tt>",
    "on-click": "gnome-clocks",
    "on-click-middle": "kitty --class peaclock -e peaclock",
    "calendar": {
      "mode": "year",
      "mode-mon-col": 3,
      "weeks-pos": "right",
      "on-scroll": 1,
      "format": {
        "months": "<span color='#ffb786'><b>{}</b></span>",
        "days": "<span color='#e2e2e2'>{}</span>",
        "weeks": "<span color='#c9ca93'>W{}</span>",
        "weekdays": "<span color='#ffb786'><b>{}</b></span>",
        "today": "<span color='#131313' background='#ffb786'><b>{}</b></span>"
      }
    },
    "actions": {
      "on-click-right": "mode",
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down"
    }
  },

  "custom/weather": {
    "format": "{}",
    "exec": "python3 ~/.config/waybar/scripts/weather.py",
    "interval": 1800,
    "return-type": "json"
  },

  "custom/inhibit-suspend": {
    "format": "{}",
    "exec": "if pgrep -x 'hypridle' > /dev/null; then echo '{\"text\": \"󰾪\", \"tooltip\": \"Idle enabled. Click to disable.\", \"class\": \"enabled\"}'; else echo '{\"text\": \"󰅶\", \"tooltip\": \"Idle disabled. Click to enable.\", \"class\": \"disabled\"}'; fi",
    "return-type": "json",
    "interval": 5,
    "signal": 9,
    "on-click": "~/.config/waybar/scripts/toggle_hypridle.sh",
    "escape": true
  },

  "custom/updates-trigger": {
    "format": "",
    "exec": "echo ''",
    "exec-if": "grep -q '\"class\":\"pending\"' ~/.cache/waybar-updates.json 2>/dev/null",
    "interval": 5,
    "tooltip": false
  },

  "custom/updates": {
    "exec": "~/.config/waybar/scripts/updates.sh",
    "interval": 1800,
    "signal": 8,
    "return-type": "json",
    "format": "{}",
    "tooltip": true,
    "on-click": "kitty --class system_update --hold -e ~/.config/waybar/scripts/updates.sh run"
  },

  "custom/notification": {
    "justify": "center",
    "align": 0.5,
    "tooltip-format": "Left Click: Open panel\nMiddle Click: Clear All\nRight Click: Do Not Disturb",
    "format": "{}",
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "~/.config/waybar/scripts/notifications.sh status",
    "interval": 2,
    "on-click": "~/.config/waybar/scripts/notifications.sh toggle",
    "on-click-middle": "~/.config/waybar/scripts/notifications.sh clear",
    "on-click-right": "~/.config/waybar/scripts/notifications.sh dnd",
    "signal": 8,
    "escape": true
  },

  "custom/theme-toggle": {
    "format": "",
    "tooltip-format": "Theme Controls\n\n LMB  Dark Mode\n RMB  Light Mode\n MMB  Wallpaper",
    "on-click": "~/.local/bin/theme-mode.sh dark",
    "on-click-right": "~/.local/bin/theme-mode.sh light",
    "on-click-middle": "~/.local/bin/wallpaper.sh"
  },

  "tray": {
    "icon-size": 15,
    "spacing": 6,
    "show-passive-items": true
  },

  "hyprland/workspaces": {
    "on-click": "activate",
    "format": "{icon}",
    "format-window-separator": " ",
    "window-rewrite-default": "",
    "window-rewrite": {
      "class<firefox>": "",
      "class<kitty>": "",
      "class<discord>": "",
      "class<vlc>": "󰕼",
      "class<Code>": "󰨞",
      "class<thunar>": "󰝰",
      "class<spotify>": "",
      "class<obsidian>": "󰎞"
    },
    "persistent-workspaces": {
      "*": 5
    },
    "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'",
    "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'"
  },

/*  "custom/mpris-trigger": {
    "format": "♪",
    "exec": "echo '♪'",
    "exec-if": "playerctl status 2>/dev/null | grep -qE 'Playing|Paused'",
    "interval": 1,
    "tooltip": false
  },*/

/*  "mpris": {
    "format": "{player_icon} {title}",
    "format-paused": "{status_icon} <i>{title}</i>",
    "format-stopped": "",
    "max-length": 35,
    "player-icons": {
      "default": "󰎆",
      "mpv": "󰎇",
      "spotify": "󰓇",
      "firefox": "󰈹",
      "zen-bin": "󰗝"
    },
    "status-icons": {
      "paused": "󰏤"
    },
    "tooltip-format": "{player} - {artist}\n{title}\n{album}",
    "on-click": "playerctl play-pause",
    "on-scroll-up": "playerctl next",
    "on-scroll-down": "playerctl previous"
  },*/

  "custom/net-speed": {
    "exec": "~/.config/waybar/scripts/network_meter.sh --horizontal",
    "return-type": "json",
    "format": "{}",
    "interval": 1,
    "tooltip": true
  },

  "network": {
    "format-wifi": "󰤨",
    "format-ethernet": "󰈀",
    "format-disconnected": "󰤭",
    "format-linked": "󰈁",
    "tooltip-format-wifi": "󰤨 {essid}\n󱑽 {signalStrength}%\n󰩟 {ipaddr}",
    "tooltip-format-ethernet": "󰈀 Ethernet\n󰩟 {ipaddr}",
    "tooltip-format-disconnected": "󰤭 Disconnected",
    "on-click": "kitty -e nmtui"
  },

  "bluetooth": {
    "format": "󰂯",
    "format-disabled": "󰂲",
    "format-connected": "󰂱 {num_connections}",
    "format-connected-battery": "󰂱 {device_battery_percentage}%",
    "tooltip-format": "{controller_alias}\n{controller_address}\n\n{device_enumerate}",
    "tooltip-format-connected": "{controller_alias}\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "󰂱 {device_alias}",
    "tooltip-format-enumerate-connected-battery": "󰂱 {device_alias} ({device_battery_percentage}%)",
    "on-click": "blueman-manager",
    "on-click-right": "kitty --class bluetui -e bluetui"
  },

  "pulseaudio#output": {
    "format": "{icon} {volume}%",
    "format-muted": "󰖁",
    "format-bluetooth": "󰂰 {volume}%",
    "format-bluetooth-muted": "󰂲",
    "format-icons": {
      "headphone": "󰋋",
      "hands-free": "󰋎",
      "headset": "󰋎",
      "phone": "",
      "portable": "",
      "car": "",
      "default": ["󰕿", "󰖀", "󰕾"]
    },
    "on-click": "pavucontrol",
    "on-click-right": "kitty --class cava -e cava",
    "on-click-middle": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
    "on-scroll-up": "pactl set-sink-volume @DEFAULT_SINK@ +5%",
    "on-scroll-down": "pactl set-sink-volume @DEFAULT_SINK@ -5%",
    "tooltip-format": "{desc}\nVolume: {volume}%\n\nLMB: Pavucontrol\nRMB: Cava\nMMB: Mute Toggle\nScroll: Volume",
    "scroll-step": 5,
    "max-volume": 150
  },

  "backlight": {
    "format": "{icon} {percent}",
    "tooltip-format": "Brightness: {percent}%\n\n LMB  Brightness\n RMB  Notifications\n MMB  Night Light",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -t -sw",
    "on-click-middle": "~/.local/bin/nightlight.sh",
    "on-scroll-up": "brightnessctl set +5%",
    "on-scroll-down": "brightnessctl set 5%-",
    "format-icons": ["󰃞", "󰃟", "󰃠"]
  },

  "cpu": {
    "interval": 2,
    "format": "󰍛 {usage}%",
    "on-click": "kitty -e btop",
    "states": {
      "warning": 70,
      "critical": 90
    }
  },

  "memory": {
    "interval": 2,
    "format": "󰘚 {percentage}%",
    "format-alt": "󰘚 {used:0.1f}G",
    "on-click": "kitty --class btop -e btop",
    "tooltip-format": "RAM: {used:0.2f} GiB / {total:0.2f} GiB ({percentage}%)\nAvailable: {avail:0.2f} GiB\nSwap: {swapUsed:0.2f} GiB / {swapTotal:0.2f} GiB\n\nLMB: I/O Monitor",
    "states": {
      "warning": 70,
      "critical": 90
    }
  },

  "battery": {
    "states": {
      "good": 80,
      "warning": 30,
      "critical": 15
    },
    "on-click": "kitty --class power_menu --hold -e ~/.config/waybar/scripts/power-menu.sh",
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-plugged": "󰚥 {capacity}%",
    "format-full": "󰁹 Full",
    "tooltip-format": "{timeTo}\n\n󱟦 Health: {health}%\n󱐋 Power: {power:.2f}W",
    "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
  },

  "custom/power": {
    "format": "⏻",
    "on-click": "~/.local/bin/power-menu.sh",
    "tooltip-format": "Power Menu"
  }
}
