profile external {
    output eDP-1 disable
    output "Samsung Electric Company LS27FG53x H9DL300352" enable mode 2560x1440@200Hz position 0,0
}

profile extend {
    output eDP-1 enable mode 1920x1080@144Hz position 0,0
    output "Samsung Electric Company LS27FG53x H9DL300352" enable mode 2560x1440@200Hz position 1920,0
}

profile laptop {
    output eDP-1 enable mode 1920x1080@144Hz
    output "Samsung Electric Company LS27FG53x H9DL300352" disable
}

profile undocked {
    output eDP-1 enable mode 1920x1080@144Hz
}